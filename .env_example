MOODLE_URL=https://moodle.org
IDNUMBER_SEARCH=*2023_4*
IDNUMBER_SEARCH_LIST=["*2024*","*2025*"]
IDNUMBER_LIST=["ADVICE_CENTRE","RVC_STUDY_SKILLS"]
MOODLE_TOKEN=xxxx
MOODLE_SERVICE_NAME=rvc_external_webservices
MOODLE_REST_TOKEN_SOURCE=configured
MOODLE_USER=username
MOODLE_PASSWORD=password

# Where fetched course folders land and where build_staging_content.py reads
# and writes. Default course_data. For a learn-uat fetch set USE_UAT=true,
# fill the UAT_MOODLE_* keys below, and point this at course_data_uat so the
# environments never share a corpus (curriculum_mapping
# docs/PLAN_uat_staging.md).
COURSE_DATA_DIR=course_data

# learn-uat twin connection, used when USE_UAT=true.
USE_UAT=false
UAT_MOODLE_URL=
UAT_MOODLE_TOKEN=
UAT_MOODLE_SERVICE_NAME=rvc_external_webservices
UAT_MOODLE_REST_TOKEN_SOURCE=configured
UAT_MOODLE_USER=
UAT_MOODLE_PASSWORD=