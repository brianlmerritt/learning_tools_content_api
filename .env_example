# Credentials and server URLs ONLY. Run settings (course filters, use_uat,
# course_data_dir) live in config.yaml, which is committed.

# Live Learn connection.
MOODLE_URL=https://learn.rvc.ac.uk
MOODLE_TOKEN=your_token_here
MOODLE_SERVICE_NAME=your service name here
MOODLE_REST_TOKEN_SOURCE=configured
MOODLE_USER=your_admin_user_here
MOODLE_PASSWORD=your_admin_password_here

# learn-uat twin connection, used when config.yaml sets use_uat: true.
UAT_MOODLE_URL=
UAT_MOODLE_TOKEN=
UAT_MOODLE_SERVICE_NAME=your service name here
UAT_MOODLE_REST_TOKEN_SOURCE=configured
UAT_MOODLE_USER=
UAT_MOODLE_PASSWORD=
